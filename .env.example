# ---- 伺服器 ----
# 選填，預設 3000
PORT=3000
# 連 RDS 時設成 true（本機不用設）
DATABASE_SSL=false
# Express 前面有幾層代理：本機與直連=0、前面有 Nginx 或 CloudFront=1、CloudFront→ALB=2
TRUST_PROXY=0

# ---- Unsplash ----
# 必填。到 https://unsplash.com/developers 建立應用程式取得 Access Key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# ---- 資料庫（PostgreSQL）----
# 必填
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# 選填，連線池大小，預設 10
DATABASE_POOL_SIZE=10

# DOCKER_DATABASE_URL=postgresql://user:password@host.docker.internal:5432/dbname
# 只有用 docker compose 連「本機」資料庫時才加：主機名要用 host.docker.internal。
# 連 RDS 時不用設，直接用上面的 DATABASE_URL

# ---- 登入驗證 ----
# 必填，用來簽發登入 token，請使用夠長的隨機字串
JWT_SECRET=your_jwt_secret
# 必填，token 有效期。要帶單位，例如 7d（7 天）、12h（12 小時）；
# 只寫數字（如 7）會被當成毫秒，登入後立刻過期
JWT_EXPIRES_DAY=7d

# ---- 忘記密碼（寄信）----
# 以下 MAIL_* 與 FRONTEND_URL 只有「忘記密碼」寄重設信時才會用到
MAIL_HOST=smtp.gmail.com
# 選填，預設 587（465 會自動改用 SSL）
MAIL_PORT=587
MAIL_USER=your_email_address
# Gmail 要使用「應用程式密碼」，不是登入密碼
MAIL_PASS=your_email_app_password
# 選填，寄件人，沒填就用 MAIL_USER
MAIL_FROM=your_email_address
# 重設密碼連結的網站網址，結尾不要加斜線
FRONTEND_URL=http://localhost:3000
# 選填，重設連結有效時間，預設 15m
RESET_PASSWORD_EXPIRES=15m
# 選填，重設連結的簽章密鑰，沒填就由 JWT_SECRET 衍生
# RESET_PASSWORD_SECRET=your_reset_password_secret

# ---- 管理員帳號 ----
# 只有執行 npm run seed:admin 建立管理員時才會用到
ADMIN_USERNAME=your_admin_username
# 至少 8 碼，且要同時包含英文字母與數字（最長 72 bytes）
ADMIN_PASSWORD=your_admin_password
ADMIN_EMAIL=your_admin_email
