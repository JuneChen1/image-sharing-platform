# ---- 伺服器 ----
# 選填，預設 3000
PORT=3000
# 連 RDS 時設成 true（本機不用設）
DATABASE_SSL=false
# Express 前面有幾層代理：本機與直連=0、前面有 Nginx、CloudFront 或 Cloudflare Tunnel=1、CloudFront→ALB=2
TRUST_PROXY=0

# ---- Unsplash ----
# 選填。Unsplash 功能目前停用，不用設定；沒設定時搜尋與網址分享的 API 直接回錯誤，不會對外發請求。
# 要啟用時到 https://unsplash.com/developers 建立應用程式取得 Access Key
# UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# ---- 資料庫（PostgreSQL）----
# 必填
DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# 選填，連線池大小，預設 10
DATABASE_POOL_SIZE=10

# DOCKER_DATABASE_URL=postgresql://user:password@host.docker.internal:5432/dbname
# 只有用 docker compose 連「本機」資料庫時才加：主機名要用 host.docker.internal。
# 連 RDS 時不用設，直接用上面的 DATABASE_URL

# ---- Cloudflare Tunnel（只有部署到 EC2 時才用，本機不用設）----
# EC2 的 .env 設 COMPOSE_PROFILES=tunnel 並填 token，docker compose 才會啟動 cloudflared。
# TUNNEL_TOKEN 是機密，到 Cloudflare Zero Trust 建立 tunnel 時取得，不要進 git
# COMPOSE_PROFILES=tunnel
# TUNNEL_TOKEN=your_tunnel_token

# ---- 登入驗證 ----
# 必填，用來簽發登入 token，請使用夠長的隨機字串
JWT_SECRET=your_jwt_secret
# 必填，token 有效期。要帶單位，例如 7d（7 天）、12h（12 小時）；
# 只寫數字（如 7）會被當成毫秒，登入後立刻過期
JWT_EXPIRES_DAY=7d

# ---- 忘記密碼（寄信）----
# 以下 MAIL_* 與 FRONTEND_URL 只有「忘記密碼」寄重設信時才會用到
MAIL_HOST=smtp.gmail.com
# 選填，預設 587（465 會自動改用 SSL）
MAIL_PORT=587
MAIL_USER=your_email_address
# 填寄信服務給的 SMTP 密碼，不是帳號的登入密碼（Gmail 用「應用程式密碼」，Brevo 等服務用它提供的 SMTP 金鑰）
MAIL_PASS=your_email_app_password
# 選填，寄件人，沒填就用 MAIL_USER
MAIL_FROM=your_email_address
# 重設密碼連結的網站網址，結尾不要加斜線
FRONTEND_URL=http://localhost:3000
# 選填，重設連結有效時間，預設 15m
RESET_PASSWORD_EXPIRES=15m
# 選填，重設連結的簽章密鑰，沒填就由 JWT_SECRET 衍生
# RESET_PASSWORD_SECRET=your_reset_password_secret

# ---- 上傳圖片 ----
# 選填，圖片存在哪：local（本機磁碟，預設）或 s3（線上用）
# STORAGE_DRIVER=local
# 選填，local 驅動的存放目錄，預設是專案根目錄的 uploads/（已加進 .gitignore 與 .dockerignore）
# UPLOADS_DIR=
# STORAGE_DRIVER=s3 時使用。S3_BUCKET 必填；憑證不要寫在這裡：
# 本機用 AWS CLI 的 profile（設 AWS_PROFILE），EC2 用 IAM Role，SDK 會自己找
# S3_BUCKET=your-uploads-bucket
# 選填，預設 ap-northeast-1
# S3_REGION=ap-northeast-1
# 選填，物件在 bucket 裡的前綴，預設 uploads/（IAM 權限與生命週期規則可以只針對這個前綴設定）
# S3_KEY_PREFIX=uploads/
# 選填，每位使用者每天最多上傳幾張，沒填就用程式預設的 10。
# 線上維持預設；本機測試會常常超過，可以調高（例如 1000）。要測「超過上限會被擋」時再臨時調小（例如 2）
# UPLOAD_DAILY_LIMIT=1000
# 選填，每位使用者最多保留幾張上傳的照片，預設 100
# UPLOAD_TOTAL_LIMIT=100
# 選填，每位使用者每小時最多幾次上傳請求（含失敗的），預設 30；本機反覆測試時可以調高
# UPLOAD_REQUESTS_PER_HOUR=1000

# ---- 管理員帳號 ----
# 只有執行 npm run seed:admin 建立管理員時才會用到
ADMIN_USERNAME=your_admin_username
# 至少 8 碼，且要同時包含英文字母與數字（最長 72 bytes）
ADMIN_PASSWORD=your_admin_password
ADMIN_EMAIL=your_admin_email
